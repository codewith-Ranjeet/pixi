# ==============================================================================
# Pixi-40M .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Large Model Weights & Checkpoints (exclude large binaries, preserve directory)
checkpoints/*.pt
checkpoints/pretrain/*.pt
*.pt
*.pth
*.bin
*.safetensors
!data/*.jsonl
!data/*.txt
data/chat_sft_*_train.jsonl
data/chat_sft_*_validation.jsonl
data/sft_*_train.jsonl
data/sft_*_validation.jsonl

# Large Pre-training Binary Shards
data/pretrain_bins/
data/_oasst_hub_cache/
*.bin
tokenizer/tokenizer_new.json

# GGUF / GGML Model Binaries
models/*.gguf
*.gguf

# C++ Compiled Binaries & Object Files
cpp/*.exe
*.exe
*.o
*.obj
*.dll
*.so
*.dylib
*.pdb

# Training Logs & Profiling
*.log
result/
checkpoints/**/metrics.csv
*.pt.tmp
wandb/
.system_generated/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Private or unreviewed training datasets
